QQ_APP_ID=
QQ_APP_SECRET=
V_API_KEY=你的API KEY
V_API_BASE_URL=你的BASE URL
QQ_API_BASE=https://api.sgroup.qq.com
WORKSPACE_DIR=./workspace
DATA_DIR=./data
CODEX_HOME=
CODEX_SANDBOX_MODE=workspace-write
CODEX_ENABLE_SEARCH=true
CODEX_TIMEOUT_MS=180000
CODEX_MODEL=
STATUS_THROTTLE_MS=2500
RECEIVED_MESSAGE=已收到，Codex 正在处理。
TASK_COMPLETE_MESSAGE=当前任务已完成。
QUEUE_EMPTY_MESSAGE=队列为空，暂无后续任务。
REPLY_CHUNK_SIZE=1500
MAX_INPUT_IMAGES=4
MAX_OUTPUT_IMAGES=4
MAX_IMAGE_BYTES=10485760
QQ_ENABLE_MARKDOWN=true
MEMORY_MAX_CHARS=4000

# Docker container proxy. Inside Docker, use host.docker.internal instead of 127.0.0.1.
HOST_PROXY_PORT=你的代理端口
# Optional full URL overrides. Leave empty to use HOST_PROXY_PORT.
HOST_HTTP_PROXY=
HOST_HTTPS_PROXY=
HOST_ALL_PROXY=
HOST_NO_PROXY=localhost,127.0.0.1,::1
